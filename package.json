{
    "name": "@thecause/timelinejs",
    "version": "0.1.0",
    "license": "MPL-2.0",
    "description": "Fork of TimelineJS3 (Knight Lab) adding three React-based rendering skins (Archive / Cinematic / Editorial) on top of the existing data pipeline.",
    "dependencies": {
        "dompurify": "^3.1.7",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "wicg-inert": "^3.1.2"
    },
    "devDependencies": {
        "@babel/cli": "^7.28.6",
        "@babel/core": "^7.29.0",
        "@babel/preset-env": "^7.29.0",
        "@babel/preset-react": "^7.28.5",
        "adm-zip": "^0.4.14",
        "babel-jest": "^29.7.0",
        "babel-loader": "^9.2.1",
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.2",
        "file-loader": "^6.0.0",
        "fs-extra": "^9.0.1",
        "html-webpack-plugin": "^5.5.0",
        "http-server": "^14.1.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^30.2.0",
        "less": "^3.11.3",
        "less-loader": "^6.1.1",
        "lodash": "^4.17.21",
        "mini-css-extract-plugin": "^2.6.0",
        "npm-run-all": "^4.1.5",
        "prompt": "^1.0.0",
        "simple-git": "^3.36.0",
        "style-loader": "^1.2.1",
        "trash-cli": "^7.2.0",
        "webpack": "^5.96.1",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.2.2",
        "webpack-merge": "^4.2.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TheCause/TimelineJS3.git"
    },
    "keywords": ["timeline", "react", "visualization", "fork"],
    "author": "Régis Rigaud",
    "bugs": {
        "url": "https://github.com/TheCause/TimelineJS3/issues"
    },
    "homepage": "https://github.com/TheCause/TimelineJS3#readme",
    "scripts": {
        "test": "jest",
        "dist": "run-s clean build",
        "disttest": "npm run dist && http-server dist -o '/embed/index.html?debug=true&language=es&script_path='",
        "compare": "npm run dist && http-server dist -o '/embed/compare.html'",
        "clean": "trash dist",
        "build": "webpack --config webpack.prod.js && node tasks/compile_less.js",
        "start": "npx webpack serve --open --config webpack.dev.js",
        "stage": "npm run dist && node tasks/stage.js",
        "stage_latest": "npm run dist && node tasks/stage.js latest",
        "stage_dev": "npm run dist && node tasks/stage.js dev",
        "demo:archive": "webpack --config webpack.demo.js && http-server -o /examples/react-archive.html",
        "serve": "npm run dist && http-server dist -p 8765 -c-1 -o",
        "serve:only": "http-server dist -p 8765 -c-1 -o",
        "check:links": "tools/check-links.sh http://localhost:8765",
        "prepublishOnly": "npm run dist"
    },
    "contributors": [
        {
            "name": "Zach Wise (upstream)",
            "email": "wise@northwestern.edu",
            "url": "https://github.com/zachwise"
        },
        {
            "name": "Joe Germuska (upstream)",
            "email": "joegermuska@northwestern.edu",
            "url": "https://github.com/JoeGermuska"
        }
    ]
}
